# SHADOW Executive OS — environment configuration template.
#
# Copy this file to `.env` inside each service directory that needs it
# (`services/api/.env`, `services/ai/.env`) and fill in real values for
# your machine. Never commit the resulting `.env` files.
#
#   cd services/api && cp ../../.env.example .env
#   cd services/ai  && cp ../../.env.example .env
#
# Each service only reads the variables it uses (see comments below) and
# ignores the rest, so it's safe to keep one shared file.

# ---------------------------------------------------------------------------
# Postgres (services/api) — must match how you're actually running Postgres.
# docker-compose.yml maps the container's 5432 to host port 5433, so the
# default below only works if you ran `docker compose up -d postgres`. If
# you're pointing at a different Postgres (a native install, a different
# port, a managed instance), change this to match — the app will otherwise
# fail every request that touches the database with ECONNREFUSED.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://shadow:shadow_dev_password@localhost:5433/shadow_os

# ---------------------------------------------------------------------------
# API gateway (services/api)
# ---------------------------------------------------------------------------
API_PORT=4000
# Secret used to sign/verify JWT access tokens. Change this for any
# deployment beyond your own machine.
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_TTL=15m

# Where the API gateway reaches the Python AI service, and the shared
# secret the AI service requires on every internal request (must match
# AI_SERVICE_INTERNAL_TOKEN below exactly).
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_INTERNAL_TOKEN=change_me_internal_token

# ---------------------------------------------------------------------------
# AI service (services/ai)
# ---------------------------------------------------------------------------
AI_SERVICE_PORT=8000
# Must be identical to AI_SERVICE_INTERNAL_TOKEN above.
# (pydantic-settings reads this as AI_SERVICE_INTERNAL_TOKEN too.)

# Leave blank to run with the offline stub provider (no external calls).
# Set a real key to get live Claude responses and real tool-use.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---------------------------------------------------------------------------
# Frontend (apps/web) — read at build/dev time by Vite, not at runtime.
# Put this one in apps/web/.env instead.
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:4000/api/v1
